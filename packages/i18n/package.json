{
  "name": "@remix-run/i18n",
  "version": "0.0.0",
  "description": "Composable internationalization primitives for Remix applications",
  "author": "Michael Jackson <mjijackson@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/remix-run/remix.git",
    "directory": "packages/i18n"
  },
  "homepage": "https://github.com/remix-run/remix/tree/main/packages/i18n#readme",
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./ui": "./src/ui.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./ui": {
        "types": "./dist/ui.d.ts",
        "default": "./dist/ui.js"
      },
      "./package.json": "./package.json"
    }
  },
  "devDependencies": {
    "@remix-run/assert": "workspace:*",
    "@remix-run/fetch-router": "workspace:*",
    "@remix-run/headers": "workspace:*",
    "@remix-run/test": "workspace:*",
    "@remix-run/ui": "workspace:*",
    "@types/dom-navigation": "1.0.6",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:"
  },
  "dependencies": {
    "@remix-run/fetch-router": "workspace:^",
    "@remix-run/headers": "workspace:^",
    "@remix-run/ui": "workspace:^"
  },
  "scripts": {
    "build": "tsgo -p tsconfig.build.json",
    "clean": "git clean -fdX",
    "prepublishOnly": "pnpm run build",
    "test": "remix-test",
    "test:bun": "bun x --bun remix-test",
    "typecheck": "tsgo --noEmit"
  },
  "keywords": [
    "i18n",
    "internationalization",
    "localization",
    "locale",
    "translation",
    "middleware"
  ]
}
